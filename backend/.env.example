PORT=8088
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fb_auditoria?sslmode=disable
# 32+ bytes aleatórios — obrigatório quando DATABASE_URL está setada
JWT_SECRET=
COOKIE_SECURE=false
# Cadastro público (POST /api/auth/register): fechado por padrão. Só "true" reabre a rota da API, para
# desenvolvimento; a tela /register do frontend sempre redireciona para o login.
ALLOW_SELF_REGISTER=false
APP_URL=http://localhost:3088
ALLOWED_ORIGINS=http://localhost:3088
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Oracle da JC (leitura) — mesmas variáveis do FB_FAROL. Credencial só aqui/Coolify, nunca no git.
# Obrigatórias, sem padrão no repositório. Credencial só no backend/.env (fora do git) e no Coolify.
JC_ORACLE_HOST=
JC_ORACLE_PORT=1521
JC_ORACLE_SERVICE=
JC_ORACLE_USER=
JC_ORACLE_PASS=
# Empresa (companies.id) que recebe a ingestão — a JC cadastrada neste sistema; preencha no Coolify/.env
JC_EMPRESA_ID=
# Views do DRE (realizado e orçado)
JC_ORACLE_DRE_VIEWS=

# Tamanho máximo do arquivo de carga (MB). O Cloudflare Tunnel limita o corpo da requisição
# (100 MB nos planos Free e Pro); acima disso só vale para acesso direto à API.
CARGA_MAX_MB=1024
